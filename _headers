/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(self "https://elevenlabs.io" "https://*.elevenlabs.io")
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com https://*.elevenlabs.io https://static.cloudflareinsights.com; connect-src 'self' https://*.elevenlabs.io wss://*.elevenlabs.io https://cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.elevenlabs.io; media-src 'self' blob: https://*.elevenlabs.io; frame-src https://*.elevenlabs.io; worker-src 'self' blob:; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=604800

/styles.css
  Cache-Control: public, max-age=86400
